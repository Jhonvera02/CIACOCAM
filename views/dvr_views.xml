<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view -->
    <record id="view_ciacocam_dvr_form" model="ir.ui.view">
        <field name="name">ciacocam.dvr.form</field>
        <field name="model">ciacocam.dvr</field>
        <field name="arch" type="xml">
            <form string="DVR">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="marca"/>
                            <field name="modelo"/>
                            <field name="numero_serie"/>
                        </group>
                        <group>
                            <field name="ip_address"/>
                            <field name="puerto"/>
                            <field name="capacidad_canales"/>
                            <field name="capacidad_disco"/>
                        </group>
                        <group>
                            <field name="ubicacion_id"/>
                            <field name="fecha_instalacion"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cámaras">
                            <field name="camara_ids"/>
                        </page>
                        <page string="Notas">
                            <field name="notas"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_ciacocam_dvr_list" model="ir.ui.view">
        <field name="name">ciacocam.dvr.list</field>
        <field name="model">ciacocam.dvr</field>
        <field name="arch" type="xml">
            <list string="DVRs">
                <field name="name"/>
                <field name="marca"/>
                <field name="modelo"/>
                <field name="ip_address"/>
                <field name="ubicacion_id"/>
                <field name="state" decoration-danger="state == 'fuera_servicio'" decoration-warning="state == 'con_fallas'" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_ciacocam_dvr_search" model="ir.ui.view">
        <field name="name">ciacocam.dvr.search</field>
        <field name="model">ciacocam.dvr</field>
        <field name="arch" type="xml">
            <search string="Buscar DVR">
                <field name="name"/>
                <field name="ubicacion_id"/>
                <field name="state"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Ubicación" name="group_ubicacion" context="{'group_by':'ubicacion_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ciacocam_dvr" model="ir.actions.act_window">
        <field name="name">DVRs</field>
        <field name="res_model">ciacocam.dvr</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
