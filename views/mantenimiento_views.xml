<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view -->
    <record id="view_ciacocam_mantenimiento_form" model="ir.ui.view">
        <field name="name">ciacocam.mantenimiento.form</field>
        <field name="model">ciacocam.mantenimiento</field>
        <field name="arch" type="xml">
            <form string="Mantenimiento">
                <header>
                    <button name="action_iniciar" string="Iniciar" type="object" invisible="state != 'programado'" class="oe_highlight"/>
                    <button name="action_completar" string="Completar" type="object" invisible="state != 'en_proceso'" class="oe_highlight"/>
                    <button name="action_cancelar" string="Cancelar" type="object" invisible="state in ('completado', 'cancelado')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tipo"/>
                            <field name="fecha_programada"/>
                            <field name="fecha_ejecucion"/>
                        </group>
                        <group>
                            <field name="tecnico_id"/>
                            <field name="ubicacion_id"/>
                            <field name="camara_id"/>
                            <field name="dvr_id"/>
                            <field name="incidencia_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="descripcion"/>
                    </group>
                    <notebook>
                        <page string="Resultado">
                            <field name="resultado"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_ciacocam_mantenimiento_list" model="ir.ui.view">
        <field name="name">ciacocam.mantenimiento.list</field>
        <field name="model">ciacocam.mantenimiento</field>
        <field name="arch" type="xml">
            <list string="Mantenimientos">
                <field name="name"/>
                <field name="tipo"/>
                <field name="fecha_programada"/>
                <field name="tecnico_id"/>
                <field name="ubicacion_id"/>
                <field name="state" decoration-success="state == 'completado'" decoration-info="state == 'en_proceso'" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_ciacocam_mantenimiento_search" model="ir.ui.view">
        <field name="name">ciacocam.mantenimiento.search</field>
        <field name="model">ciacocam.mantenimiento</field>
        <field name="arch" type="xml">
            <search string="Buscar Mantenimiento">
                <field name="name"/>
                <field name="state"/>
                <field name="tipo"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Ubicación" name="group_ubicacion" context="{'group_by':'ubicacion_id'}"/>
                    <filter string="Técnico" name="group_tecnico" context="{'group_by':'tecnico_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ciacocam_mantenimiento" model="ir.actions.act_window">
        <field name="name">Mantenimientos</field>
        <field name="res_model">ciacocam.mantenimiento</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
